<?xml version="1.0" encoding="UTF-8"?>
<!--
  tetherkit-helper 的 LaunchDaemon 配置。

  安装到 /Library/LaunchDaemons/com.tetherkit.helper.plist（需要 root）。
  Scripts/install-helper.sh 会替你做。

  ★ 为什么是传统 LaunchDaemon 而不是 SMAppService ★
    SMAppService 靠代码签名的 designated requirement 双向绑定 App 与 helper，
    源码分发下每台机器编出的 cdhash 都不同，DR 必然对不上。而且它不弹密码框 ——
    审批入口是「系统设置 → 登录项与扩展」，对命令行安装的工具很别扭。
    详见 docs/GUI-SPIKE.md 第 3.3 节。

  ★ 为什么没有 KeepAlive ★
    声明了 MachServices 之后，launchd 会在有人连这个服务时**按需**把它拉起来。
    加 KeepAlive 只会让它在没人用时也常驻，白占内存 —— 而且 helper 一旦跑起来
    就会一直活着（见 main.swift 末尾的说明），不需要 launchd 帮忙重启。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tetherkit.helper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/com.tetherkit.helper</string>
    </array>

    <!-- 声明 Mach 服务，launchd 据此按需拉起。名字必须与
         HelperConstants.machServiceName 完全一致。 -->
    <key>MachServices</key>
    <dict>
        <key>com.tetherkit.helper</key>
        <true/>
    </dict>

    <!-- 日志。helper 自身的问题（起不来、崩溃）只能从这里看。 -->
    <key>StandardOutPath</key>
    <string>/var/log/tetherkit-helper.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/tetherkit-helper.log</string>

    <!-- 数据路径要开 BPF 描述符与大量 USB 传输，默认的 256 个描述符偏紧。 -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
</dict>
</plist>
