<?xml version="1.0" encoding="UTF-8"?>
<!--
  TetherKit.app 的 Info.plist 模板。

  Scripts/build-gui.sh 会把 __TETHERKIT_VERSION__ 替换成语义版本号
  （如 0.1.6，供 UpdateChecker 做数值比较），并把 __TETHERKIT_BUILD__ 替换成
  构建戳（{YYYYMMDD}-XENO-BETA-{仓库简称}-{commit短哈希}，便于溯源），再拷进
  TetherKit.app/Contents/。

  App 本身**不需要任何 entitlement**：它以普通用户身份运行，既不碰 USB 也不碰
  网卡，全部特权操作都通过 XPC 交给 tetherkit-helper。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>TetherKit</string>
    <key>CFBundleDisplayName</key>
    <string>TetherKit</string>
    <key>CFBundleIdentifier</key>
    <string>com.tetherkit.app</string>
    <key>CFBundleExecutable</key>
    <string>TetherKit</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Dock / 访达用的图标。Resources/AppIcon.icns 由 build-gui.sh 拷入。 -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleShortVersionString</key>
    <string>__TETHERKIT_VERSION__</string>
    <!-- 构建戳：{YYYYMMDD}-XENO-BETA-{仓库简称}-{commit短哈希}，由 build-gui.sh 注入 -->
    <key>CFBundleVersion</key>
    <string>__TETHERKIT_BUILD__</string>

    <!-- 支持的界面语言。
         文案本身是编进二进制的（见 TetherKitIPC/Localization.swift 里为什么不
         走 .lproj），所以这里**不影响**实际显示什么 —— 它的作用是让
         「系统设置 → 通用 → 语言与地区 → 应用程序」里能列出 TetherKit 并给出
         这两个选项。App 内的语言菜单与这条各自独立，两者都能用。
         第一项同时充当 CFBundleDevelopmentRegion 的角色。 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hans</string>
    </array>

    <!-- Swift 的 Observation 与 ContentUnavailableView 需要 macOS 14。
         命令行部分仍然支持 13.3，两者是各自独立的产物。 -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- 这是一个有窗口的普通应用，不是后台代理。 -->
    <key>LSUIElement</key>
    <false/>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <!-- 会话跑着的时候被系统「自动终止」等于把用户的网络断掉。 -->
    <key>NSSupportsSuddenTermination</key>
    <false/>
</dict>
</plist>
